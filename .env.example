# Copy to backend/.env (backend) — no secrets are required; nothing here calls an external service.
# SQLite file (relative paths resolve from your current directory; default: backend/data/carbon_optimizer.db)
DATABASE_URL=sqlite:///./data/carbon_optimizer.db
# Origins allowed by CORS (comma separated). The Vite dev server proxy does not need CORS, but a direct call does.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Worker polling interval (wall-clock seconds)
WORKER_TICK_SECONDS=0.5
# How many recent SSE events are kept for reconnecting clients
EVENT_BUFFER_SIZE=500

# Frontend (put in frontend/.env.local if needed)
# VITE_API_BASE_URL=http://127.0.0.1:8000     # default: "" (use the Vite /api proxy)
# VITE_PROXY_TARGET=http://127.0.0.1:8000     # where the dev proxy forwards /api
